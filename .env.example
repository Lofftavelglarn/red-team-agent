# Target: financial-agent stand. These defaults work from the red-team Docker container.
REDTEAM_AGENT_URL=http://host.docker.internal:8600
REDTEAM_MONGO_URI=mongodb://host.docker.internal:27017
REDTEAM_MONGO_DB=agent_memory
REDTEAM_REDIS_URL=redis://host.docker.internal:6379/0

# Stand users and their long-lived API keys. Create each key at http://localhost:8501.
REDTEAM_ATTACKER=1001
REDTEAM_VICTIM=1003
REDTEAM_SECONDARY=1002
REDTEAM_TARGET_ATTACKER_API_KEY=
REDTEAM_TARGET_VICTIM_API_KEY=
REDTEAM_TARGET_SECONDARY_API_KEY=

# Attacker model. Any OpenAI-compatible provider can be used.
REDTEAM_ATTACKER_BASE_URL=https://api.openai.com/v1
REDTEAM_ATTACKER_API_KEY=
REDTEAM_ATTACKER_MODEL=
REDTEAM_ATTACKER_MAX_TOKENS=4096
REDTEAM_ATTACKER_TEMPERATURE=0.7
REDTEAM_ATTACKER_TIMEOUT=120

# Judge model. Keep it separate from both the attacker and the target model.
REDTEAM_JUDGE_BASE_URL=https://api.openai.com/v1
REDTEAM_JUDGE_API_KEY=
REDTEAM_JUDGE_MODEL=
REDTEAM_JUDGE_MAX_TOKENS=4096
REDTEAM_JUDGE_TEMPERATURE=0
REDTEAM_JUDGE_TIMEOUT=120

# Campaign defaults. Values can be overridden per docker compose run.
REDTEAM_REPEATS=3
REDTEAM_LOOP=3
REDTEAM_AUTH_MODE=vulnerable
REDTEAM_SEED=0
REDTEAM_POLICY_CONTEXT_LIMIT=20
REDTEAM_INCLUDE_DISABLED=0
REDTEAM_FIXTURES_READY=0

# Cleanup and isolation. scoped removes only this campaign's artifacts and is the safe
# default; full wipes the whole database and additionally requires ALLOW_FULL_RESET=1.
REDTEAM_CLEANUP_MODE=scoped
REDTEAM_ALLOW_FULL_RESET=0
# Debug only: leaves campaign artifacts in the stand instead of restoring it.
REDTEAM_KEEP_FINAL_STATE=0
# Empty means a random id per campaign; set it to reuse one across runs.
# Allowed characters: letters, digits and underscore, 4-32 of them. Hyphens and glob
# wildcards are rejected: the id goes into the scoped cleanup queries.
REDTEAM_CAMPAIGN_ID=
# Keep the full text of trace events under artifacts/raw (credentials are stripped).
# 0 leaves only the redacted excerpts in events.jsonl and promises no raw copy.
REDTEAM_STORE_RAW=1
# Isolation fingerprint hashes whole collections. Above this many documents in one
# collection the state is reported as unverifiable instead of hashed partially.
REDTEAM_FINGERPRINT_DOC_LIMIT=5000
